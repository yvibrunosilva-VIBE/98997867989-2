# Copie este arquivo para .env e preencha os valores para desenvolvimento local.
# O Railway injeta essas variaveis automaticamente em producao.

# URL de conexao com o PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/gym_inventory

# Chave secreta do Flask (gere uma aleatoria: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Modo debug (nunca use true em producao)
DEBUG=false

# URL do Redis (Railway fornece automaticamente via variavel de ambiente)
REDIS_URL=redis://localhost:6379
